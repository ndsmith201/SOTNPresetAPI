meta {
  name: Get preset
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/presets/{{preset_id}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("preset_id") || bru.getEnvVar("preset_id");
  if (!id || !/^[0-9a-f]{32}$/.test(id)) {
    throw new Error("Run Create preset first or set preset_id to a shared catalog ID.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Public request. Run Create preset first, or set preset_id manually to a 32-character shared catalog ID.
}
