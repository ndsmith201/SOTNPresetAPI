meta {
  name: List presets
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/presets?limit={{limit}}
  body: none
  auth: none
}

params:query {
  limit: {{limit}}
  ~cursor: {{presets_cursor}}
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("presets_cursor", res.getBody().nextCursor || "");
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Public list, one page at a time. The next cursor is saved as presets_cursor.
  To request another page, enable the cursor parameter in Params and resend. Stop when nextCursor is absent; an empty page alone does not mean completion.
  Items are ordered by shared catalog ID, not score or date.
}
