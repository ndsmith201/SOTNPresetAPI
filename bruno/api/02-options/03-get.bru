meta {
  name: Get option
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/options/{{option_id}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("option_id") || bru.getEnvVar("option_id");
  if (!id || !/^[0-9a-f]{32}$/.test(id)) {
    throw new Error("Run Create option first or set option_id to a shared catalog ID.");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Public request. Run Create option first, or set option_id manually to a 32-character shared catalog ID.
}
