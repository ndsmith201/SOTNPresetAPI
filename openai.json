    "/v1/options/{id}/vote": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CatalogID"
        }
      ],
      "put": {
        "operationId": "setOptionVote",
        "tags": [
          "Options"
        ],
        "summary": "Upvote, downvote, or remove your option vote",
        "description": "One vote per authenticated account per item. Set value to 1 for upvote, -1 for downvote, or 0 to remove. Repeating the same value does not increment totals. Vote changes and aggregate counters are updated transactionally. Missing items return 404 without creating votes. Returned totals may include concurrent votes; there is no per-user vote field in the response.",
        "security": [
          {
            "CognitoAccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DevUser"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoteInput"
              },
              "examples": {
                "upvote": {
                  "summary": "Upvote",
                  "value": {
                    "value": 1
                  }
                },
                "downvote": {
                  "summary": "Downvote",
                  "value": {
                    "value": -1
                  }
                },
                "remove": {
                  "summary": "Remove your vote",
                  "value": {
                    "value": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item with current aggregate vote totals.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionItem"
                },
                "example": {
                  "id": "0123456789abcdef0123456789abcdef",
                  "kind": "options",
                  "createdBy": "example-cognito-subject",
                  "createdAt": "2026-09-09T20:00:00Z",
                  "upvotes": 1,
                  "downvotes": 0,
                  "score": 1,
                  "data": {
                    "comment": "Community gameplay tweak",
                    "description": "Enable the library shortcut.",
                    "category": "gameplay",
                    "type": "string",
                    "value": "{\"libraryShortcut\":true}",
                    "rawJson": true,
                    "additionalWrites": [],
                    "address": null,
                    "gameInit": false,
                    "statEdit": false
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
