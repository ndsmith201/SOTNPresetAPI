{
  "openapi": "3.0.3",
  "info": {
    "title": "SOTN Preset API",
    "version": "1.0.0",
    "description": "Community options, exported presets, and per-account voting for SOTNPresetGenerator. Reads are public. In AWS, writes require a Cognito access token with token_use=access, a nonempty sub, the configured client audience and issuer, and scope aws.cognito.signin.user.admin. Obtain and refresh tokens through Cognito; this API does not implement login endpoints. For cmd/local only, omit bearer authentication and send X-Dev-User; the production Lambda ignores that header. The security requirements in this document describe production. Import this file into OpenAPI-compatible integration tools. Replace the AWS server placeholder with the deployed stack's ApiUrl. The file name openai.json is intentional; its contents are a standard OpenAPI document."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local development (go run ./cmd/local). Writes use X-Dev-User instead of a bearer token."
    },
    {
      "url": "https://{apiId}.execute-api.{region}.amazonaws.com",
      "description": "AWS deployment placeholder; replace with the stack ApiUrl before use.",
      "variables": {
        "apiId": {
          "default": "replace-with-api-id",
          "description": "API Gateway ID from the deployed stack."
        },
        "region": {
          "default": "us-west-2",
          "description": "Region of the deployed stack."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Process health."
    },
    {
      "name": "Options",
      "description": "User-created randomizer options."
    },
    {
      "name": "Presets",
      "description": "Full exported randomizer presets."
    }
  ],
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "summary": "Check process health",
        "description": "Returns process health only; does not probe DynamoDB.",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is responding.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/GatewayFailure"
          }
        }
      }
    },
