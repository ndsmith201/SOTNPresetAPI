  "components": {
    "securitySchemes": {
      "CognitoAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cognito access token (not ID token). The API Gateway authorizer verifies issuer, client audience, expiry and scope aws.cognito.signin.user.admin. Use Authorization: Bearer <AccessToken>. This scheme describes AWS only; local development uses X-Dev-User."
      }
    },
    "parameters": {
      "CatalogID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Shared catalog ID, not a generator-local numeric ID or metadata.id.",
        "schema": {
          "$ref": "#/components/schemas/CatalogID"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "description": "Maximum number of items in a page; the database size limit can yield fewer."
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Opaque nextCursor from the previous page of the same collection. Omit on the first request."
      },
      "DevUser": {
        "name": "X-Dev-User",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "description": "LOCAL DEVELOPMENT ONLY: required for writes to cmd/local when using the localhost server. Selects a test identity. Never authenticates AWS requests and is ignored by production.",
        "example": "alice"
      }
    },
    "schemas": {
      "CatalogID": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$",
        "minLength": 32,
        "maxLength": 32,
        "description": "Server-generated shared catalog ID. Distinct from local numeric SQLite option IDs and preset metadata.id.",
        "example": "0123456789abcdef0123456789abcdef"
      },
      "OptionInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comment",
          "category",
          "type",
          "value"
        ],
        "properties": {
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S",
            "description": "Nonblank label; the server limit is 200 UTF-8 bytes, not characters.",
            "x-maxBytes": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000,
            "default": "",
            "description": "Optional explanation; null becomes an empty string. Maximum 10000 UTF-8 bytes.",
            "x-maxBytes": 10000
          },
          "category": {
            "type": "string",
            "enum": [
              "world",
              "items",
              "challenge",
              "relics",
              "gameplay"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "char",
              "short",
              "word",
              "long",
              "string"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Write value encoded as a string. When rawJson is true, this string must encode a JSON object. Numeric values remain strings."
          },
          "address": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "pattern": "\\S",
            "default": null,
            "description": "Optional nonblank write address. Missing or null is normalized to null."
          },
          "gameInit": {
            "type": "boolean",
            "nullable": true,
            "default": false,
            "description": "Use game initialization writes. Missing or null becomes false."
          },
          "statEdit": {
            "type": "boolean",
            "nullable": true,
            "default": false,
            "description": "Use stat-edit writes. Missing or null becomes false."
          },
          "rawJson": {
            "type": "boolean",
            "nullable": true,
            "default": false,
            "description": "Interpret value as a JSON object to merge into the preset. Missing or null becomes false."
          },
          "additionalWrites": {
            "type": "array",
            "nullable": true,
            "maxItems": 256,
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Additional randomizer write objects; missing or null becomes an empty array. The randomizer validates write semantics."
          }
        },
        "example": {
          "comment": "Community gameplay tweak",
          "description": "Enable the library shortcut.",
          "category": "gameplay",
          "type": "string",
          "value": "{\"libraryShortcut\":true}",
          "rawJson": true,
          "additionalWrites": []
        },
        "description": "Submit a CreateOptionInput object directly, without a data wrapper, local ID, readOnly flag, author identity, or vote totals."
      },
      "OptionData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "comment",
          "description",
          "category",
          "type",
          "value",
          "address",
          "gameInit",
          "statEdit",
          "rawJson",
          "additionalWrites"
        ],
        "properties": {
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S",
            "description": "Nonblank label; the server limit is 200 UTF-8 bytes, not characters.",
            "x-maxBytes": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "default": "",
            "description": "Optional explanation; null becomes an empty string. Maximum 10000 UTF-8 bytes.",
            "x-maxBytes": 10000
          },
          "category": {
            "type": "string",
            "enum": [
              "world",
              "items",
              "challenge",
              "relics",
              "gameplay"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "char",
              "short",
              "word",
              "long",
              "string"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Write value encoded as a string. When rawJson is true, this string must encode a JSON object. Numeric values remain strings."
          },
          "address": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "pattern": "\\S",
            "default": null,
            "description": "Optional nonblank write address. Missing or null is normalized to null."
          },
          "gameInit": {
            "type": "boolean",
            "default": false,
            "description": "Use game initialization writes. Missing or null becomes false."
          },
          "statEdit": {
            "type": "boolean",
            "default": false,
            "description": "Use stat-edit writes. Missing or null becomes false."
          },
          "rawJson": {
            "type": "boolean",
            "default": false,
            "description": "Interpret value as a JSON object to merge into the preset. Missing or null becomes false."
          },
          "additionalWrites": {
            "type": "array",
            "maxItems": 256,
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Additional randomizer write objects; missing or null becomes an empty array. The randomizer validates write semantics."
          }
        },
        "description": "Stored option with all optional fields normalized."
      },
      "PresetData": {
        "type": "object",
        "required": [
          "metadata"
        ],
        "additionalProperties": true,
        "properties": {
          "metadata": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": true,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S",
                "x-maxBytes": 200,
                "description": "Exported preset identifier; nonblank and at most 200 UTF-8 bytes. Not unique in the shared catalog."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S",
                "x-maxBytes": 200,
                "description": "Display name; nonblank and at most 200 UTF-8 bytes."
              }
            },
            "description": "Metadata is preserved as supplied. For same-name updates, the verified username must match the existing stored author array; incoming authors do not grant update permission."
          }
        },
        "description": "Full exported randomizer preset, not an editor draft containing local optionIds. All other settings and JSON number precision are preserved. The randomizer owns validation of those settings.",
        "example": {
          "metadata": {
            "id": "community-casual",
            "name": "Community Casual",
            "description": "A casual preset with the library shortcut enabled.",
            "author": [
              "Your Name"
            ]
          },
          "inherits": "casual",
          "libraryShortcut": true
        }
      },
      "ItemMetadata": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "createdBy",
          "createdAt",
          "upvotes",
          "downvotes",
          "score"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/CatalogID"
          },
          "kind": {
            "type": "string",
            "enum": [
              "options",
              "presets"
            ]
          },
          "createdBy": {
            "type": "string",
            "readOnly": true,
            "description": "Verified Cognito subject of the submitter; never client-supplied."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "upvotes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "readOnly": true
          },
          "downvotes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "readOnly": true
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "readOnly": true,
            "description": "upvotes minus downvotes"
          }
        }
      },
      "VoteInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "enum": [
              -1,
              0,
              1
            ],
            "description": "1 = upvote, -1 = downvote, 0 = remove your vote."
          }
        },
        "example": {
          "value": 1
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "unauthorized",
                  "not_found",
                  "method_not_allowed",
                  "conflict",
                  "body_too_large",
                  "unsupported_media_type",
                  "internal_error",
                  "forbidden"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "GatewayError": {
        "type": "object",
        "additionalProperties": true,
        "description": "API Gateway may reject a request before Lambda runs and return its own error body.",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "OptionItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ItemMetadata"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "options"
                ]
              },
              "data": {
                "$ref": "#/components/schemas/OptionData"
              }
            }
          }
        ]
      },
      "OptionPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionItem"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Opaque cursor for this collection. Omitted at the end; continue even if a page has no items."
          }
        }
      },
      "PresetItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ItemMetadata"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "presets"
                ]
              },
              "data": {
                "$ref": "#/components/schemas/PresetData"
              }
            }
          }
        ]
      },
      "PresetPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresetItem"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Opaque cursor for this collection. Omitted at the end; continue even if a page has no items."
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Malformed JSON, unsupported fields, invalid option/preset/vote, invalid pagination, or normalized submission exceeding 128 KiB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "invalid_request",
                "message": "value must be -1, 0, or 1"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid authentication. Production writes require a Cognito access token; ID tokens are rejected. API Gateway may return a different error shape.",
        "content": {
          "application/json": {
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/GatewayError"
                }
              ]
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authorization was rejected by API Gateway, a same-name option belongs to a different authenticated subject, or a same-name preset does not list the verified username in its stored author array.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown catalog ID or route.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "not_found",
                "message": "item not found"
              }
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "HTTP method is not supported on this route.",
        "headers": {
          "Allow": {
            "schema": {
              "type": "string"
            },
            "description": "Supported methods."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "A concurrent write conflicted, or multiple existing items have the submitted name. Vote conflicts may be retried. For submissions, refresh the catalog before retrying; ambiguous existing names require a unique name.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "conflict",
                "message": "concurrent update; retry the request"
              }
            }
          }
        }
      },
      "BodyTooLarge": {
        "description": "Request body exceeds 128 KiB. The local development server may return plain text.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Writes require Content-Type: application/json; charset parameters are accepted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Throttled": {
        "description": "API Gateway throttled the request; retry with backoff.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "InternalError": {
        "description": "Database or internal server error. Internal details are not returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "GatewayFailure": {
        "description": "An infrastructure failure or other API Gateway response outside the application error contract.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      }
    }
  }
}
