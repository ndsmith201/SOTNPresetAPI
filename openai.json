      "post": {
        "operationId": "createPreset",
        "tags": [
          "Presets"
        ],
        "summary": "Create or update a community preset",
        "description": "Send exported JSON directly, without a data wrapper; maximum 128 KiB. A new name creates an item (201). A matching name updates the existing JSON (200) only when the verified access-token username appears in its stored metadata.author array. Names and usernames ignore case and surrounding spaces. The submitted author list cannot authorize its own update. Updates preserve the catalog ID, creation metadata, and votes. Unauthorized collisions return 403, even if another preset with that name lists the caller as an author; ambiguous matches or concurrent changes return 409. Do not automatically retry uncertain submissions.",
        "security": [
          {
            "CognitoAccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DevUser"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Submission JSON, at most 131072 bytes; normalized JSON has the same limit.",
          "x-maxBytes": 131072,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresetData"
              },
              "example": {
                "metadata": {
                  "id": "community-casual",
                  "name": "Community Casual",
                  "description": "A casual preset with the library shortcut enabled.",
                  "author": [
                    "Your Name"
                  ]
                },
                "inherits": "casual",
                "libraryShortcut": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated preset with its existing identity and votes.",
            "headers": {
              "Location": {
                "description": "Relative path to the created item.",
                "schema": {
                  "type": "string"
                },
                "example": "/v1/presets/0123456789abcdef0123456789abcdef"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetItem"
                }
              }
            }
          },
          "201": {
            "description": "Created catalog item.",
            "headers": {
              "Location": {
                "description": "Relative path to the created item.",
                "schema": {
                  "type": "string"
                },
                "example": "/v1/presets/0123456789abcdef0123456789abcdef"
