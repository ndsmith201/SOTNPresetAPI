            "description": "One page of options.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionPage"
                },
                "example": {
                  "items": [
                    {
                      "id": "0123456789abcdef0123456789abcdef",
                      "kind": "options",
                      "createdBy": "example-cognito-subject",
                      "createdAt": "2026-09-09T20:00:00Z",
                      "upvotes": 0,
                      "downvotes": 0,
                      "score": 0,
                      "data": {
                        "comment": "Community gameplay tweak",
                        "description": "Enable the library shortcut.",
                        "category": "gameplay",
                        "type": "string",
                        "value": "{\"libraryShortcut\":true}",
                        "rawJson": true,
                        "additionalWrites": [],
                        "address": null,
                        "gameInit": false,
                        "statEdit": false
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "default": {
            "$ref": "#/components/responses/GatewayFailure"
          }
        }
      },
      "post": {
        "operationId": "createOption",
        "tags": [
          "Options"
        ],
        "summary": "Create or update a community option",
        "description": "Send the input object directly, without a data wrapper. Maximum request and normalized JSON size: 128 KiB. A new comment/name creates an item (201). A matching name updates the existing JSON (200) only when the authenticated Cognito subject exactly matches its stored createdBy. Names ignore case and surrounding spaces across all categories. Usernames and submitted fields cannot grant update permission. Updates preserve the catalog ID, creation metadata, and votes. Unauthorized collisions return 403; ambiguous matches or concurrent changes return 409. Do not automatically retry uncertain submissions; refresh the catalog first.",
        "security": [
          {
            "CognitoAccessToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DevUser"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Submission JSON, at most 131072 bytes; normalized JSON has the same limit.",
          "x-maxBytes": 131072,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptionInput"
              },
              "example": {
                "comment": "Community gameplay tweak",
                "description": "Enable the library shortcut.",
                "category": "gameplay",
                "type": "string",
                "value": "{\"libraryShortcut\":true}",
                "rawJson": true,
                "additionalWrites": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated the existing option owned by the authenticated subject; identity and votes are preserved.",
            "headers": {
              "Location": {
                "description": "Relative path to the existing item.",
                "schema": {
                  "type": "string"
                },
                "example": "/v1/options/0123456789abcdef0123456789abcdef"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionItem"
                }
              }
            }
          },
          "201": {
            "description": "Created catalog item.",
            "headers": {
              "Location": {
                "description": "Relative path to the created item.",
                "schema": {
                  "type": "string"
                },
                "example": "/v1/options/0123456789abcdef0123456789abcdef"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionItem"
                },
                "example": {
                  "id": "0123456789abcdef0123456789abcdef",
                  "kind": "options",
                  "createdBy": "example-cognito-subject",
                  "createdAt": "2026-09-09T20:00:00Z",
                  "upvotes": 0,
                  "downvotes": 0,
                  "score": 0,
                  "data": {
                    "comment": "Community gameplay tweak",
                    "description": "Enable the library shortcut.",
                    "category": "gameplay",
                    "type": "string",
                    "value": "{\"libraryShortcut\":true}",
                    "rawJson": true,
                    "additionalWrites": [],
                    "address": null,
                    "gameInit": false,
                    "statEdit": false
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/Throttled"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "default": {
            "$ref": "#/components/responses/GatewayFailure"
          }
        }
      }
    },
